{
  "opencollection": "1.0.0",
  "info": {
    "name": "Swell Backend Account Addresses Checkout API",
    "version": "2025-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Store-Id",
      "value": "{{X-Store-Id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Checkout",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.swell.store/api/cart/submit-order"
          },
          "docs": "Converts the current cart into an order. Requires billing.method and shipping."
        }
      ]
    }
  ],
  "bundled": true
}