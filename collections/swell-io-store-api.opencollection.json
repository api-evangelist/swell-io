{
  "opencollection": "1.0.0",
  "info": {
    "name": "Swell Backend Account Addresses Store API",
    "version": "2025-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Store-Id",
      "value": "{{X-Store-Id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Store",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Store Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swell.store/api/settings"
          },
          "docs": "Retrieve Store Settings"
        },
        {
          "info": {
            "name": "Retrieve Payment Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swell.store/api/settings/payments"
          },
          "docs": "Retrieve Payment Settings"
        },
        {
          "info": {
            "name": "List Supported Currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.swell.store/api/settings/currencies"
          },
          "docs": "List Supported Currencies"
        }
      ]
    }
  ],
  "bundled": true
}